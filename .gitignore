# ── macOS / Python cruft ─────────────────────────────────────────────────────
.DS_Store
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# ── Data lives on HuggingFace: CollagenHelixLabs/Collagen_Data ───────────────
# Fetched via data_locations.data_root(); never committed here.
0_data/
2_deterministic_build/outputs/
3_ml_prediction/outputs/
3_ml_prediction/boltz/raw/
4_scoring/results/
4_scoring/compute_cost/results/
# Benchmark rebuilds. Deliberately NOT 2_deterministic_build/outputs/, which is
# the working-tree half of the cdsm/* prefixes: structures left there shadow the
# published ones for readers without COLLAGEN_DATA_ROOT set, and would be pushed
# over them by `upload_to_huggingface.py --all`.
4_scoring/compute_cost/rebuild/

# ── Run artefacts / logs ─────────────────────────────────────────────────────
*.log
# Provenance: why each candidate structure was filtered out. Kept despite the
# *.log rule above. (Trailing comments are not valid on a .gitignore pattern
# line — they become part of the pattern, so this must stay on its own line.)
!1_download/rejected.log
3_ml_prediction/*/state.csv

# ── Machine-local editor / tooling state ─────────────────────────────────────
.claude/settings.local.json
.vscode/

# ── Vector figures: regenerated on every make_figures.py run, alongside the
#    PNGs. PDF embeds a creation timestamp, so tracking them would show all 20
#    as modified after every run even when the figures are identical. ─────────
# (Pattern must match FILES, not the directory: git cannot re-include a file
#  whose parent directory is excluded, so the negations below would fail.)
figures/figures_pdf/*.pdf

# Hand-drawn figures are NOT regenerated by make_figures.py, so their PDFs are
# the only copy and must be tracked. Add a line here for any new hand-made one.
!figures/figures_pdf/fig_2_kabsch.pdf
!figures/figures_pdf/fig_3_cdsmpipeline.pdf
!figures/figures_pdf/fig_4_cdsm_capability.pdf
!figures/figures_pdf/fig_6_a-c_overlay_analysis.pdf

# ── Third-party binary: built via scripts/get_usalign.sh ─────────────────────
tools/USalign

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
*.token
